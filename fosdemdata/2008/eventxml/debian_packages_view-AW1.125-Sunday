          <link href="http://meetings-archive.debian.net/pub/debian-meetings/2008/fosdem/ogg_theora/384x288/Creating_a_nice_view_into_the_Debian_archives___Frank_Lichtenheld.ogg">Video (Ogg/Theora)</link>
      </links>
      <video></video>
      <end></end>
  </event>