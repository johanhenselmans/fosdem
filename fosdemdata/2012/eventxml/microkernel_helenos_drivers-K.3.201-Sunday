          <link href="bzr://bzr.helenos.org/mainline">HelenOS main repository</link>
          <link href="http://trac.helenos.org/wiki/DeviceDrivers">Writing Device Drivers for HelenOS wiki article</link>
      </links>
      <video></video>
      <end></end>
  </event>