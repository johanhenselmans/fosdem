          <link href="403/78_Fosdem.pdf">Fosdem.pdf (slides)</link>
          <link href="http://video.fosdem.org/2012/maintracks/k.1.105/Caret_and_Stick.webm">Video recording</link>
      </links>
      <video></video>
      <end></end>
  </event>